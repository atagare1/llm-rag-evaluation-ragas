# Copy this file to .env and replace placeholders. Never commit real secrets.
#
# Phase 1 root tests use OPENAI_API_KEY + OPENAI_BASE_URL (ChatOpenAI / Mixtral).
# Live DeepEval judges use OPENROUTER_API_KEY + OPENAI_BASE_URL.
# With OPENAI_BASE_URL=OpenRouter, Phase 1 Mixtral calls currently 401
# (Missing Authentication header). That is expected unless this pair is a
# working Together host/key. Do not change Phase 1 code to "fix" it.
OPENAI_API_KEY=your_together_ai_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Live DeepEval and live RAGAS Llama helpers (not Phase 1 Mixtral).
OPENROUTER_API_KEY=your_openrouter_key
DEEPEVAL_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct

# Phase 1 historical defaults in utils.py. Unchanged.
# If RAGAS_LLM_MODEL is unset, live RAGAS Llama helpers default to
# meta-llama/llama-3.3-70b-instruct. A value here is also read by those helpers.
RAG_API_URL=https://rahulshettyacademy.com/rag-llm/ask
RAGAS_LLM_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
RAGAS_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# Optional experimental pytest gates. Not production-validated.
# RAGAS_THRESHOLD_CONTEXT_PRECISION=0.8
# RAGAS_THRESHOLD_CONTEXT_RECALL=0.7
# RAGAS_THRESHOLD_FAITHFULNESS=0.8
# RAGAS_THRESHOLD_HALLUCINATION=0.8
# RAGAS_THRESHOLD_ANSWER_RELEVANCY=0.8
# RAGAS_THRESHOLD_FACTUAL_CORRECTNESS=0.8
# RAGAS_THRESHOLD_CONTEXTUAL_RELEVANCY=0.8
# RAGAS_THRESHOLD_CONTEXTUAL_PRECISION=0.8
# RAGAS_THRESHOLD_CONTEXTUAL_RECALL=0.7
